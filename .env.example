# Copy to .env.local and fill in. Without a project ID the site renders the
# built-in seed content (src/content/seed.ts) so the frontend runs before
# Sanity is set up.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Shared secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=
